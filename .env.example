# AI_PROVIDER selects the active provider: openrouter | openai | gemini | local | stub. Default: openrouter.
# stub is test-only: it returns canned deterministic responses with no network calls or API key.
AI_PROVIDER=openrouter
# Format: sk-or-v1-<your key>. Leave blank to be prompted in Settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# OpenAI (ChatGPT). Used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Gemini. Used when AI_PROVIDER=gemini (via LiteLLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Local (e.g. Ollama). Used when AI_PROVIDER=local; no API key required by default
LOCAL_API_BASE=http://localhost:11434
LOCAL_API_KEY=
LOCAL_MODEL=llama3.1
SECRET_KEY=change-me-32-chars-minimum
DB_URL=sqlite:///./qi_stat_studio.db
# DATABASE_URL is also accepted for container platforms; DB_URL takes precedence.
FERNET_KEY=  # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The spaCy model that finds names loads in the background at startup, and scrubbing waits for it.
# Set to 0 only on a very slow machine, then the first AI call after a restart waits for the load.
WARM_PHI_NER=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=qi-stat-studio@example.com
